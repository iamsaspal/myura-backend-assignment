<%- include("partials/header") %>

<h2>Update Product Stock</h2>

<form action="/api/products/update-stock" method="POST">

<select name="product_id" class="form-control mb-3">

<% products.forEach(p=>{ %>

<option value="<%=p.id%>">

<%=p.product_name%> (Stock:<%=p.stock%>)

</option>

<% }) %>

</select>

<input
type="number"
name="stock"
placeholder="New Stock"
class="form-control mb-3"
>

<button class="btn btn-primary">

Update Stock

</button>

</form>

<%- include("partials/footer") %>