<%- include("partials/header") %>

<h2>Update Product Stock</h2>

<div class="card p-4 col-md-6">

<form action="/update-stock" method="POST">

<select class="form-control mb-3" name="product_id">

<% products.forEach(product=>{ %>

<option value="<%=product.id%>">

<%=product.product_name%> (Stock: <%=product.stock%>)

</option>

<% }) %>

</select>

<input class="form-control mb-3" name="stock" placeholder="New Stock">

<button class="btn btn-warning">

Update Stock

</button>

</form>

</div>

<%- include("partials/footer") %>