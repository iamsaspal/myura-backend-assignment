<%- include("partials/header") %>

<h2>Add Product</h2>

<div class="card p-4 col-md-6">

<form action="/api/products" method="POST">

<input class="form-control mb-3" name="product_name" placeholder="Product Name">

<input class="form-control mb-3" name="price" placeholder="Price">

<input class="form-control mb-3" name="category" placeholder="Category">

<input class="form-control mb-3" name="stock" placeholder="Stock">

<button class="btn btn-primary">Add Product</button>

</form>

</div>

<%- include("partials/footer") %>