<!DOCTYPE html>
<html>
<head>

<title>Myura Admin</title>
<meta name="viewport" content="width=device-width, initial-scale=1">


<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>

body{
background:#f4f6f9;
}

.sidebar{
height:100vh;
background:#212529;
color:white;
padding:20px;
}

.sidebar a{
color:white;
text-decoration:none;
display:block;
margin:12px 0;
}

.sidebar a:hover{
background:#495057;
padding:6px;
border-radius:6px;
}

.card{
border-radius:10px;
box-shadow:0 2px 8px rgba(0,0,0,0.1);
}


@media(max-width:768px){

.sidebar{
position:fixed;
left:-220px;
top:0;
width:220px;
transition:0.3s;
z-index:1000;
}

.sidebar.active{
left:0;
}

}


</style>

</head>

<body>

<div class="container-fluid">

<div class="row">

<div id="sidebar" class="col-md-2 sidebar">

<h4>Myura Admin</h4>
<button onclick="logout()" class="btn btn-danger mt-3">Logout</button>


<hr>

<a href="/">Dashboard</a>
<a href="/add-product">Add Product</a>
<a href="/order">Place Order</a>
<a href="/update-stock">Update Stock</a>
<a href="/order-history">Order History</a>

</div>

<div class="col-md-10 p-4">
<button id="menuBtn" class="btn btn-dark d-md-none mb-3" onclick="toggleSidebar()">
☰ Menu
</button>

    <script>

/* SIDEBAR CONTROL */

const sidebar = document.getElementById("sidebar")

const token = localStorage.getItem("token")

const page = window.location.pathname

/* LOGIN PAGE PAR SIDEBAR HIDE */

if(page === "/login"){
sidebar.style.display = "none"
}

/* AGAR LOGIN NA HO */

if(!token){
sidebar.style.display = "none"
}






</script>


    <script>

        function toggleSidebar(){

const sidebar = document.getElementById("sidebar")

sidebar.classList.toggle("active")

}

function logout(){

localStorage.removeItem("token")

window.location.replace("/login")


}

</script>
