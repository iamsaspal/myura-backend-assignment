<%- include("partials/header") %>

<h2 class="mb-4">Product Dashboard</h2>

<a href="/add-product" class="btn btn-primary mb-3">Add Product</a>
<a href="/order" class="btn btn-success mb-3">Place Order</a>
<a href="/update-stock" class="btn btn-warning mb-3">Update Stock</a>

<input 
type="text" 
id="search" 
class="form-control mb-3" 
placeholder="Search product..."
>

<div id="lowStockAlert"></div>

<div class="card p-3 mb-4">

<h4>Inventory Analytics</h4>

<canvas id="stockChart"></canvas>

</div>

<div class="card p-3">

<table class="table table-bordered table-hover">

<thead class="table-dark">

<tr>
<th>ID</th>
<th>Name</th>
<th>Price</th>
<th>Category</th>
<th>Stock</th>
<th>Action</th>
</tr>

</thead>

<tbody id="products"></tbody>

</table>

</div>


<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>

let productsData = []

fetch("/api/products")

.then(res=>res.json())

.then(data=>{

productsData = data

renderProducts(data)

renderChart(data)

checkLowStock(data)

})



function renderProducts(products){

const table=document.getElementById("products")

table.innerHTML=""

products.forEach(p=>{

table.innerHTML+=`

<tr>

<td>${p.id}</td>

<td>${p.product_name}</td>

<td>₹${p.price}</td>

<td>${p.category}</td>

<td>

${p.stock < 5
? `<span class="badge bg-danger">${p.stock}</span>`
: `<span class="badge bg-success">${p.stock}</span>`}

</td>

<td>

<a 
href="/edit-product/${p.id}" 
class="btn btn-sm btn-primary">

Edit

</a>

<button 
class="btn btn-sm btn-danger"
onclick="deleteProduct(${p.id})">

Delete

</button>

</td>

</tr>

`

})

}



document.getElementById("search").addEventListener("keyup",(e)=>{

const keyword = e.target.value.toLowerCase()

const filtered = productsData.filter(p=>

p.product_name.toLowerCase().includes(keyword)

)

renderProducts(filtered)

})



function checkLowStock(data){

let lowStockProducts = data.filter(p => p.stock < 5)

if(lowStockProducts.length > 0){

let alertHTML = `

<div class="alert alert-danger">

<strong>Low Stock Alert!</strong>

<ul>

`

lowStockProducts.forEach(p=>{

alertHTML += `<li>${p.product_name} - only ${p.stock} left</li>`

})

alertHTML += `

</ul>

</div>

`

document.getElementById("lowStockAlert").innerHTML = alertHTML

}

}



function renderChart(data){

const names = data.map(p => p.product_name)

const stocks = data.map(p => p.stock)

const ctx = document.getElementById("stockChart")

new Chart(ctx,{

type:"bar",

data:{

labels:names,

datasets:[{

label:"Stock",

data:stocks,

backgroundColor:"#0d6efd"

}]

}

})

}



async function deleteProduct(id){

if(!confirm("Delete this product?")) return

await fetch(`/api/products/${id}`,{

method:"DELETE"

})

location.reload()

}

</script>

<%- include("partials/footer") %>