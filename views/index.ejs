<%- include("partials/header") %>

<h2 class="mb-4">Product List</h2>

<a href="/add-product" class="btn btn-primary mb-3">Add Product</a>
<a href="/order" class="btn btn-success mb-3">Place Order</a>
<a href="/update-stock" class="btn btn-warning mb-3">Update Stock</a>


<!-- Dashboard Stats -->

<div class="row mb-4">

<div class="col-md-4">

<div class="card p-3">

<h6>Total Products</h6>

<h3 id="totalProducts">0</h3>

</div>

</div>


<div class="col-md-4">

<div class="card p-3">

<h6>Low Stock Products</h6>

<h3 id="lowStock">0</h3>

</div>

</div>


<div class="col-md-4">

<div class="card p-3">

<h6>Total Inventory</h6>

<h3 id="totalStock">0</h3>

</div>

</div>

</div>

<input 
type="text" 
id="search" 
class="form-control mb-3" 
placeholder="Search product..."
>

<div class="card p-3">

<table class="table table-bordered table-hover">

<thead class="table-dark">

<tr>

<th>ID</th>
<th>Name</th>
<th>Price</th>
<th>Category</th>
<th>Stock</th>
<th>Action</th>

</tr>

</thead>

<tbody id="products"></tbody>

</table>

</div>



<script>

let productsData = []

fetch("/api/products")
.then(res=>res.json())
.then(data=>{

productsData = data
renderProducts(data)

})

function renderProducts(products){

const table = document.getElementById("products")
table.innerHTML=""

products.forEach(p=>{

table.innerHTML += `

<tr>

<td>${p.id}</td>
<td>${p.product_name}</td>
<td>₹${p.price}</td>
<td>${p.category}</td>

<td>

${p.stock < 5
? `<span class="badge bg-danger">${p.stock}</span>`
: `<span class="badge bg-success">${p.stock}</span>`}

</td>

<td>

<button 
class="btn btn-sm btn-danger"
onclick="deleteProduct(${p.id})">

Delete

</button>

</td>

</tr>

`

})

}

document.getElementById("search").addEventListener("keyup",(e)=>{

const keyword = e.target.value.toLowerCase()

const filtered = productsData.filter(p=>

p.product_name.toLowerCase().includes(keyword)

)

renderProducts(filtered)

})



async function deleteProduct(id){

if(!confirm("Delete this product?")) return

await fetch(`/api/products/${id}`,{
method:"DELETE"
})

location.reload()

}
</script>


<%- include("partials/footer") %>