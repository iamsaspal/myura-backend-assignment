<%- include("partials/header") %>

<h2 class="mb-4">Product Dashboard</h2>

<input 
type="text" 
id="search" 
class="form-control mb-3" 
placeholder="Search product..."
>

<div id="lowStockAlert"></div>

<div class="card p-3">

<div class="table-responsive">

<table class="table table-bordered table-hover">

<thead class="table-dark">

<tr>
<th>Sr.No</th>
<th>Product ID</th>
<th>Name</th>
<th>Price</th>
<th>Category</th>
<th>Stock</th>
<th>Action</th>
</tr>

</thead>

<tbody id="products"></tbody>

</table>

</div>
</div>

<!-- PAGINATION -->

<nav class="mt-4 d-flex justify-content-center">
<ul class="pagination" id="pagination"></ul>
</nav>

<script>
if(!localStorage.getItem("token")){
window.location="/login"
}
let productsData = []
let currentPage = 1
const limit = 10

/* FETCH PRODUCTS */

function loadProducts(page=1){

fetch(`/api/products?page=${page}&limit=${limit}`,{

headers:{
Authorization: localStorage.getItem("token")
}

})

.then(res=>res.json())

.then(data=>{

productsData = data.products

renderProducts(data.products,page)

renderPagination(data.totalPages,page)

checkLowStock(data.products)

})

}

/* RENDER PRODUCTS */

function renderProducts(products,page){

const table=document.getElementById("products")

table.innerHTML=""

let count = (page - 1) * limit + 1

products.forEach(p=>{

table.innerHTML+=`

<tr>

<td>${count++}</td>

<td>${p.id}</td>

<td>${p.product_name}</td>

<td>₹${p.price}</td>

<td>${p.category}</td>

<td>

${p.stock < 5
? `<span class="badge bg-danger">${p.stock}</span>`
: `<span class="badge bg-success">${p.stock}</span>`}

</td>

<td>

<a href="/edit-product/${p.id}" class="btn btn-sm btn-primary">
Edit
</a>

<button 
class="btn btn-sm btn-danger"
onclick="deleteProduct(${p.id})">
Delete
</button>

</td>

</tr>

`

})

}

/* PAGINATION */

function renderPagination(totalPages,page){

const pagination=document.getElementById("pagination")

pagination.innerHTML=""

for(let i=1;i<=totalPages;i++){

pagination.innerHTML+=`

<li class="page-item ${page===i?'active':''}">

<a class="page-link" href="#" onclick="changePage(${i})">${i}</a>

</li>

`

}

}

function changePage(page){

currentPage = page

loadProducts(page)

}

/* SEARCH */

document.getElementById("search").addEventListener("keyup",(e)=>{

const keyword = e.target.value.toLowerCase()

const filtered = productsData.filter(p=>
p.product_name.toLowerCase().includes(keyword)
)

renderProducts(filtered,currentPage)

})

/* LOW STOCK ALERT */

function checkLowStock(data){

let lowStockProducts = data.filter(p => p.stock < 5)

if(lowStockProducts.length > 0){

let alertHTML = `

<div class="alert alert-danger">

<strong>Low Stock Alert!</strong>

<ul>

`

lowStockProducts.forEach(p=>{
alertHTML += `<li>${p.product_name} - only ${p.stock} left</li>`
})

alertHTML += `

</ul>

</div>

`

document.getElementById("lowStockAlert").innerHTML = alertHTML

}

}

/* DELETE PRODUCT */

async function deleteProduct(id){

const confirm = await Swal.fire({

title:"Delete Product?",
text:"This action cannot be undone",
icon:"warning",
showCancelButton:true,
confirmButtonColor:"#d33",
cancelButtonColor:"#3085d6",
confirmButtonText:"Yes, delete it"

})

if(!confirm.isConfirmed) return

Swal.fire({
title:"Deleting Product...",
allowOutsideClick:false,
didOpen:()=>{Swal.showLoading()}
})

try{

const res = await fetch(`/api/products/${id}`,{

method:"DELETE",

headers:{
Authorization: localStorage.getItem("token")
}

})

const result = await res.json()

Swal.close()

if(res.status !== 200){

Swal.fire({
icon:"error",
title:"Delete Failed",
text: result.message
})

}else{

Swal.fire({
icon:"success",
title:"Deleted",
text:"Product deleted successfully"
}).then(()=>{
loadProducts(currentPage)
})

}

}catch(err){

Swal.close()

Swal.fire({
icon:"error",
title:"Server Error",
text:"Unable to delete product"
})

}

}

/* INITIAL LOAD */

loadProducts()

</script>



<%- include("partials/footer") %>