<%- include("partials/header") %>

<h2>Place Order</h2>

<div class="card p-4 col-md-6">

<form id="orderForm">

<input type="text" name="customer_name" class="form-control mb-3" placeholder="Customer Name" required>

<input type="email" name="customer_email" class="form-control mb-3" placeholder="Email" required>

<select name="product_id" class="form-control mb-3" required>

<option value="">Select Product</option>

<% products.forEach(p=>{ %>

<option value="<%= p.id %>" data-stock="<%= p.stock %>">
<%= p.product_name %> (Stock:<%= p.stock %>)
</option>

<% }) %>

</select>

<input type="number" name="quantity" class="form-control mb-3" placeholder="Quantity" required min="1">

<button class="btn btn-success">Place Order</button>

</form>

</div>

<script>

document.getElementById("orderForm").addEventListener("submit", async function(e){

e.preventDefault()

const productSelect = document.querySelector("[name='product_id']")
const selectedOption = productSelect.options[productSelect.selectedIndex]

const stock = selectedOption.getAttribute("data-stock")
const quantity = document.querySelector("[name='quantity']").value

/* STOCK VALIDATION */

if(Number(quantity) > Number(stock)){

Swal.fire({
icon:"error",
title:"Stock Error",
text:"Quantity exceeds available stock"
})

return
}

/* SHOW LOADING */

Swal.fire({
title:"Processing Order...",
text:"Please wait",
allowOutsideClick:false,
didOpen:()=>{
Swal.showLoading()
}
})

const data = {
customer_name: document.querySelector("[name='customer_name']").value,
customer_email: document.querySelector("[name='customer_email']").value,
product_id: productSelect.value,
quantity: quantity
}

/* API CALL */

const res = await fetch("/api/orders",{
method:"POST",
headers:{
"Content-Type":"application/json"
},
body: JSON.stringify(data)
})

const result = await res.json()

Swal.close()

/* ERROR RESPONSE */

if(res.status !== 200){

Swal.fire({
icon:"error",
title:"Order Failed",
text: result.message
})

}else{

/* SUCCESS RESPONSE */

Swal.fire({
icon:"success",
title:"Order Placed",
text:"Your order has been created successfully"
}).then(()=>{
window.location="/"
})

}

})

</script>

<%- include("partials/footer") %>