<%- include("partials/header") %>

<h2>Place Order</h2>

<div class="card p-4 col-md-6">

<form id="orderForm">

<input class="form-control mb-3" id="name" placeholder="Customer Name">

<input class="form-control mb-3" id="email" placeholder="Email">

<select name="product_id" class="form-control" required>

<option value="">Select Product</option>

<% products.forEach(p => { %>

<option value="<%= p.id %>">
<%= p.product_name %> (Stock:<%= p.stock %>)
</option>

<% }) %>

</select>

<input 
type="number"
name="quantity"
class="form-control"
placeholder="Enter Quantity"
required
min="1"
>
<button class="btn btn-success">Place Order</button>

</form>

</div>

<script>

fetch("/api/products")
.then(res=>res.json())
.then(products=>{

const dropdown=document.getElementById("product")

products.forEach(p=>{

const option=document.createElement("option")

option.value=p.id
option.text=p.product_name+" (Stock:"+p.stock+")"

dropdown.appendChild(option)

})

})

document.getElementById("orderForm").addEventListener("submit",async(e)=>{

e.preventDefault()

const data={

customer_name:document.getElementById("name").value,
customer_email:document.getElementById("email").value,

items:[{
product_id:document.getElementById("product").value,
quantity:document.getElementById("qty").value
}]

}

const response=await fetch("/api/orders",{

method:"POST",
headers:{"Content-Type":"application/json"},
body:JSON.stringify(data)

})

const result=await response.json()

if(response.ok){
alert("Order placed")
}else{
alert(result.message)
}

})

</script>

<%- include("partials/footer") %>