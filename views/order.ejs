<%- include("partials/header") %>

<h2>Place Order</h2>

<div class="card p-4 col-md-6">

<form id="orderForm" action="/api/orders" method="POST">

<input type="text" name="customer_name" class="form-control" placeholder="Customer Name" required>

<input type="email" name="customer_email" class="form-control" placeholder="Email" required>

<select name="product_id" class="form-control" required>
<option value="">Select Product</option>
<% products.forEach(p=>{ %>
<option value="<%= p.id %>"><%= p.product_name %> (Stock:<%= p.stock %>)</option>
<% }) %>
</select>

<input type="number" name="quantity" class="form-control" placeholder="Quantity" required min="1">

<button class="btn btn-success">Place Order</button>

</form>

</div>

<script>

fetch("/api/products")
.then(res=>res.json())
.then(products=>{

const dropdown=document.getElementById("product")

products.forEach(p=>{

const option=document.createElement("option")

option.value=p.id
option.text=p.product_name+" (Stock:"+p.stock+")"

dropdown.appendChild(option)

})

})

document.getElementById("orderForm").addEventListener("submit", async function(e){

e.preventDefault()

const data = {
customer_name: document.querySelector("[name='customer_name']").value,
customer_email: document.querySelector("[name='customer_email']").value,
product_id: document.querySelector("[name='product_id']").value,
quantity: document.querySelector("[name='quantity']").value
}

const res = await fetch("/api/orders",{
method:"POST",
headers:{
"Content-Type":"application/json"
},
body: JSON.stringify(data)
})

const result = await res.json()

if(res.status !== 200){

Swal.fire({
icon:"error",
title:"Order Failed",
text: result.message
})

}else{

Swal.fire({
icon:"success",
title:"Order Placed",
text:"Your order has been created successfully"
}).then(()=>{
window.location="/"
})

}

})


</script>

<%- include("partials/footer") %>